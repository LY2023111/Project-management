# ===== 复制本文件为 .env 并填入你的真实配置（.env 已在 .gitignore 中，不会进版本库）=====

# 服务端口
APP_PORT=5200

# 会话签名密钥：换成一段随机字符串（例如 openssl rand -hex 32 的输出）
SESSION_SECRET=please-change-this-to-a-random-string

# 大模型密钥加密主密钥：用于加密数据库里存的 API Key。
# 不填会退化用 SESSION_SECRET；一旦设置请勿更改，否则已存密钥无法解密（需重新录入）
SETTINGS_SECRET=please-change-this-to-another-random-string

# 登录账号（首个管理员；AUTH_PASSWORD 不配置则无法登录）
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-please

# ===== MySQL 连接 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
# 数据库名（服务启动会自动创建，无需手动建库建表）
DB_NAME=pm_workbench

# ===== 大模型（可选，推荐在页面「用户管理 → 大模型设置」里录入，密钥会加密存库）=====
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
